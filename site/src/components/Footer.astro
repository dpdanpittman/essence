---
// The related-sites row (ESSENCE_FOOTER_LINKS) and the privacy link (ESSENCE_PRIVACY=live) appear only
// when the build sets them, so a copy of this site does not inherit another deployment's links.
import { repoUrl, footerLinks, privacyLinked, track } from '../lib/project';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <div>
      <p class="footer-name">Essence</p>
      <p class="footer-line">born from itself · carried across every session · {year}</p>
      <p class="footer-line">Essence is built by <a href="https://github.com/dpdanpittman" target="_blank" rel="noopener">Dan Pittman</a>.</p>
    </div>
    <nav aria-label="Elsewhere">
      <ul>
        <li><a href={repoUrl} target="_blank" rel="noopener" {...track('github', { where: 'footer' })}>github</a></li>
        <li><a href="/llms.txt">llms.txt</a></li>
        {privacyLinked && <li><a href="/privacy/">privacy</a></li>}
      </ul>
      {
        footerLinks.length > 0 && (
          <ul class="footer-sites" aria-label="Related sites">
            {footerLinks.map((s) => (
              <li>
                <a href={s.href} aria-current={s.current ? 'page' : undefined} {...track('xsite', { target: s.target })}>
                  {s.label}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </nav>
  </div>
</footer>
