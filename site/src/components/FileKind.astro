---
// One kind of file on the colour chart: its painted chip, its name and path,
// its parts, and the longer notes beside them.
import Swatch from './Swatch.astro';
import { pigments, type Kind } from '../lib/pigments';

interface Props {
  kind: Kind;
  id: string;
  title: string;
  path: string;
  parts: string[];
  partsLabel: string;
  /** zero-padded part numbers, as the portrait's sections are numbered */
  pad?: boolean;
  /** the part to paint in the kind's pigment */
  lead?: number;
  /** the part that points at the security part below */
  locked?: number;
}

const { kind, id, title, path, parts, partsLabel, pad = false, lead = -1, locked = -1 } = Astro.props;
const num = (i: number) => (pad ? String(i + 1).padStart(2, '0') : String(i + 1));
---

<article class:list={['kind', `kind-${kind}`]} aria-labelledby={id}>
  <div class="kind-chip">
    <Swatch kind={kind} seed={`chip-${kind}`} w={64} h={210} class="chip-tall" />
    <Swatch kind={kind} seed={`chip-${kind}-wide`} w={260} h={36} class="chip-wide" />
    <span class="kind-pigment">{pigments[kind].name}</span>
  </div>
  <div class="kind-main">
    <h3 id={id}>{title}</h3>
    <p class="path">{path}</p>
    <slot />
    <ol class="parts" aria-label={partsLabel}>
      {
        parts.map((p, i) => (
          <li class:list={{ 'part-lead': i === lead, 'part-locked': i === locked }}>
            <span class="part-num">{num(i)}</span> {p}
            {i === locked && (
              <svg class="lock" viewBox="0 0 12 14" aria-hidden="true" focusable="false">
                <rect x="1.5" y="6" width="9" height="7" rx="1" />
                <path d="M3.5 6V4.2a2.5 2.5 0 0 1 5 0V6" />
              </svg>
            )}
          </li>
        ))
      }
    </ol>
  </div>
  <div class="kind-more">
    <slot name="more" />
  </div>
</article>
