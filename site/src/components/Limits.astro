---
const limits = [
  'So far it is built for one person and one agent.',
  'The code is private.',
  'This page says what it is, not how it is built.',
];
---

<section class="border-b border-border/40">
  <div class="mx-auto max-w-4xl px-6 py-24">
    <p class="font-mono text-xs uppercase tracking-[0.22em] text-muted mb-6">
      06 · Limits
    </p>
    <h2 class="font-display text-3xl sm:text-4xl text-ink tracking-tight mb-8">
      What it is not.
    </h2>
    <ul class="space-y-4 text-ink-dim leading-relaxed max-w-2xl">
      {
        limits.map((l) => (
          <li class="flex gap-3">
            <span class="text-accent shrink-0">·</span>
            <span>{l}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
