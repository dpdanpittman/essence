---
import Entry from './Entry.astro';
import { repoUrl, track } from '../lib/project';

const limits = [
  'It is built for one person and one agent.',
  'The public repository holds the hooks, the studio engine, the templates and the tests.',
  'Synthesis is no longer local. It uses the model provider the agent already runs on. The files stay on the owner\'s machine.',
];
---

<Entry id="limits" label="12 · Limits and code" title="What it is not.">
  <div class="spread">
    <ul class="limits">
      {limits.map((l) => <li>{l}</li>)}
    </ul>

    <div class="repo">
      <h3>The repository</h3>
      <p>
        The repository holds the hooks, the studio engine, the templates
        and the tests. Its README has the install steps.
      </p>
      <p>Its old name was session-essence.</p>
      <p>
        The hooks are wired in <code>~/.claude/settings.json</code>.
        The files live in <code>~/.claude/essence/</code>.
      </p>
      <p>
        <a href={repoUrl} target="_blank" rel="noopener" {...track('github', { where: 'limits' })}>
          {repoUrl.replace(/^https:\/\//, '')} <span aria-hidden="true">→</span>
        </a>
      </p>
    </div>
  </div>
</Entry>
