---
import Entry from './Entry.astro';
import Dot from './Dot.astro';

const steps = [
  {
    title: 'A session starts',
    body: [
      'A SessionStart hook checks the portrait against a saved checksum.',
      'It puts the identity section in front of the agent.',
      'It tells the agent to read the whole portrait before its first reply.',
      'The same happens after every context compaction.',
    ],
  },
  {
    title: 'A landscape gets read',
    body: [
      'The last section of the portrait lists each landscape with its trigger words.',
      'When the conversation touches one, the agent reads that file whole before it acts.',
      'It does this once per session. Nobody has to remember to ask.',
    ],
  },
  {
    title: 'A landscape gets written',
    body: [
      'The agent updates a landscape while it still holds the picture.',
      'It writes when a thread changes state and when a block of work ends.',
      'It rewrites open threads in place. It adds traps and decisions with dates.',
    ],
  },
];
---

<Entry id="during" label="03 · During a session" title="Read at the start, written while the picture is fresh.">
  <div class="spread">
    <ol class="steps">
      {
        steps.map((s, i) => (
          <li>
            <h3><span class="step-num">{i + 1}</span> {s.title}</h3>
            <ul>
              {s.body.map((line) => <li>{line}</li>)}
            </ul>
          </li>
        ))
      }
    </ol>

    <!-- The order of events. The dots say which file each step reads or writes.
         The dashed line on the right returns to the top: after a compaction it starts again. -->
    <figure class="diagram route-figure">
      <ul class="legend" aria-hidden="true">
        <li><Dot kind="portrait" />portrait</li>
        <li><Dot kind="landscape" />landscape</li>
        <li><Dot kind="none" />no file</li>
      </ul>
      <ol class="route" aria-label="The order of events in a session">
        <li>
          <span class="route-dots"><Dot kind="none" /></span>
          <b>session start, or after a compaction</b>
        </li>
        <li>
          <span class="route-dots"><Dot kind="portrait" /></span>
          <b>SessionStart hook</b>
          <span>checks portrait checksum</span>
          <span>shows the identity section</span>
        </li>
        <li>
          <span class="route-dots"><Dot kind="portrait" /></span>
          <b>agent reads portrait.md whole</b>
          <div class="route-fork">
            <Dot kind="landscape" />
            <span>topic hits a trigger word <span class="arrow" aria-hidden="true">→</span> read that landscape whole (once)</span>
          </div>
        </li>
        <li>
          <span class="route-dots"><Dot kind="landscape" /></span>
          <b>work</b>
          <span><span class="arrow" aria-hidden="true">→</span> agent updates the landscape as threads change</span>
        </li>
        <li>
          <span class="route-dots"><Dot kind="portrait" /><Dot kind="landscape" /></span>
          <b>compaction or session end</b>
          <span><span class="arrow" aria-hidden="true">→</span> synthesis job (next section)</span>
        </li>
      </ol>
    </figure>
  </div>
</Entry>
