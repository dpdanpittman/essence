---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Gap from '../components/Gap.astro';
import Shape from '../components/Shape.astro';
import Flow from '../components/Flow.astro';
import Synthesis from '../components/Synthesis.astro';
import Superego from '../components/Superego.astro';
import Studio from '../components/Studio.astro';
import Sketchbook from '../components/Sketchbook.astro';
import Example from '../components/Example.astro';
import Ideas from '../components/Ideas.astro';
import History from '../components/History.astro';
import Story from '../components/Story.astro';
import Limits from '../components/Limits.astro';
import * as P from '../lib/project';

// SoftwareSourceCode, matching the first screen: name, version, author, licence, update date, source.
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  name: 'Essence',
  description: 'A Claude Code agent starts every session with no memory. Essence is a small set of files and hooks that carries it across that gap.',
  url: P.abs('/'),
  codeRepository: P.repoUrl,
  version: P.version,
  dateModified: P.updated,
  license: `https://spdx.org/licenses/${P.license.spdx}.html`,
  programmingLanguage: ['Python', 'Shell'],
  runtimePlatform: 'Claude Code',
  ...(P.authorName ? { author: { '@type': 'Person', name: P.authorName, url: P.authorUrl } } : {}),
};
---

<Base jsonld={jsonld}>
  <Hero />
  <Gap />
  <Shape />
  <Flow />
  <Synthesis />
  <Superego />
  <Studio />
  <Sketchbook />
  <Example />
  <Ideas />
  <History />
  <Story />
  <Limits />
</Base>
